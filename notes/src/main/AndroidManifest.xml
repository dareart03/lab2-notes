<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Напоминание показывается уведомлением (API 33+). Фото выбирается системным Photo Picker,
         поэтому CAMERA, READ_MEDIA_IMAGES и READ_EXTERNAL_STORAGE не нужны. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TODO(ipc-6): объявите здесь собственное разрешение
         edu.androidsec.notes.permission.READ_NOTES с protectionLevel="signature"
         (см. TitlesProvider.kt). -->

    <application
        android:name=".NotesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes">

        <!-- В merged-манифесте у компонентов библиотек exported задан ими самими. Экспортированный
             ProfileInstallReceiver (под signature-разрешением DUMP) нужен только для установки
             профилей прогрева через adb; приложению он не нужен, поэтому убран. -->
        <!--suppress AndroidDomInspection -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link notes://note/<id>. Фильтр пропускает любые пути этой схемы и хоста,
                 а сам параметр строго проверяет NoteDeepLink.parse(): некорректный id даёт
                 сообщение, а не падение и не открывает ничего лишнего. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="notes"
                    android:host="note" />
            </intent-filter>
        </activity>

        <!-- Кнопка «Готово» в уведомлении. exported="false": ресивер вызывает только наш
             PendingIntent (система отправляет интент от имени приложения), другим приложениям
             и adb он недоступен. -->
        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

        <!-- TODO(ipc-5): объявите androidx.core.content.FileProvider с authority
             edu.androidsec.notes.files (см. ShareNote.kt). -->

        <!-- TODO(ipc-6): объявите провайдер .provider.TitlesProvider с authority
             edu.androidsec.notes.provider, защищённый signature-разрешением
             (см. TitlesProvider.kt). -->
    </application>

</manifest>

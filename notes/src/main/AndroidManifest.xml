<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Напоминание показывается уведомлением (API 33+). Фото выбирается системным Photo Picker,
         поэтому CAMERA, READ_MEDIA_IMAGES и READ_EXTERNAL_STORAGE не нужны. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TODO(ipc-6): объявите здесь собственное разрешение
         edu.androidsec.notes.permission.READ_NOTES с protectionLevel="signature"
         (см. TitlesProvider.kt). -->

    <application
        android:name=".NotesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes">

        <!-- В merged-манифесте у компонентов библиотек exported задан ими самими. Экспортированный
             ProfileInstallReceiver (под signature-разрешением DUMP) нужен только для установки
             профилей прогрева через adb; приложению он не нужен, поэтому убран. -->
        <!--suppress AndroidDomInspection -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TODO(ipc-3): intent-filter для deep link notes://note/<id> (см. NoteDeepLink.kt). -->
        </activity>

        <!-- TODO(ipc-4): объявите ресивер .reminder.ReminderActionReceiver, закрытый для других
             приложений (см. ReminderActionReceiver.kt). -->

        <!-- TODO(ipc-5): объявите androidx.core.content.FileProvider с authority
             edu.androidsec.notes.files (см. ShareNote.kt). -->

        <!-- TODO(ipc-6): объявите провайдер .provider.TitlesProvider с authority
             edu.androidsec.notes.provider, защищённый signature-разрешением
             (см. TitlesProvider.kt). -->
    </application>

</manifest>
